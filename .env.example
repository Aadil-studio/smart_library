# Copy to .env and set the values for your environment. Never commit a real .env.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Server
HOST=127.0.0.1
PORT=8000
APP_DEBUG=0
SESSION_COOKIE_SECURE=1
REMEMBER_ME_DAYS=30

# Required only when creating the first admin in a new database.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password-reset OTP delivery.
OTP_DEV_MODE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
# Public HTTPS origin used in password-reset emails.
APP_BASE_URL=

# Database file location (default: library.db in the project root)
# LIBRARY_DB_PATH=library.db
