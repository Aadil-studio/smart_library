# DEVELOPMENT ONLY — copy to .env and adjust. Never commit a real .env.

# Flask session signing key. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# "Remember me" session lifetime in days
REMEMBER_ME_DAYS=30

# Default admin created only when the database has no admin yet (DEVELOPMENT ONLY defaults)
ADMIN_EMAIL=admin@library.com
ADMIN_PASSWORD=admin123

# Password-reset OTP delivery.
# OTP_DEV_MODE=1 returns the code in the API response for local testing (NO SMTP needed).
# To email real codes instead, set SMTP_HOST/SMTP_FROM and remove/rely on OTP_DEV_MODE=0.
OTP_DEV_MODE=1
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_FROM=library@example.edu
#SMTP_USER=
#SMTP_PASS=

# Database file location (default: library.db in the project root)
# LIBRARY_DB_PATH=library.db
